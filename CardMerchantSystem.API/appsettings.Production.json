
{
  "Database": {
    "Provider": "PostgreSql",
    "SqlServerConnection": "Server=prod-sql-server;Database=CardMerchantDb;User Id=sa;Password=YourStrongPassword;TrustServerCertificate=True;",
    "PostgreSqlConnection": "Host=prod-postgres-server;Port=5432;Database=cardmerchantdb;Username=cardmerchant_user;Password=YourStrongPassword;SSL Mode=Require;"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/cardmerchant/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "https://your-elasticsearch-url:9200",
          "indexFormat": "cardmerchant-logs-prod-{0:yyyy.MM}",
          "autoRegisterTemplate": true
        }
      }
    ],
    "Properties": {
      "Environment": "Production"
    }
  }
}